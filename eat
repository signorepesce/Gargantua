#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ -n "${GARGANTUA_PROJECT:-}" ]]; then
    cd -- "$GARGANTUA_PROJECT"
elif [[ ! -d app ]]; then
    cd -- "$SCRIPT_DIR"
fi

case "${1:-run}" in
    init|install|version|help|lock)
        exec python3 "$SCRIPT_DIR/tools/package.py" "$@" ;;
esac

APP=${APP:-app}
OUT=${OUT:-.build}
CC_BIN=${CC:-cc}
ACTION=${1:-run}

if (($# > 1)) || [[ "$ACTION" != run && "$ACTION" != build && "$ACTION" != clean &&
                    "$ACTION" != test && "$ACTION" != dev ]]; then
    echo "usage: ./eat [run|build|clean|test|dev]" >&2
    exit 2
fi

if [[ ! "$OUT" =~ ^[A-Za-z0-9_.-]+$ || "$OUT" == . || "$OUT" == .. ||
      "$OUT" == -* || -L "$OUT" ]]; then
    echo "unsafe OUT '$OUT': use a dedicated build directory directly under the project" >&2
    exit 2
fi
case "$OUT" in
    src|include|app|tests|vendor|resources|data|.git|.github|.idea|.agents|.codex)
        echo "unsafe OUT '$OUT': protected project directory" >&2
        exit 2 ;;
esac
if [[ -e "$OUT" && ! -d "$OUT" ]]; then
    echo "OUT is not a directory" >&2
    exit 2
fi
if [[ -d "$OUT" && ! -f "$OUT/.gargantua-build" ]]; then
    echo "refusing unowned build directory '$OUT'; choose a new OUT directory" >&2
    exit 2
fi

if [[ "$APP" == *'"'* || "$APP" == *'\\'* ||
      "$APP" == *$'\n'* || "$APP" == *$'\r'* ]]; then
    echo "unsafe APP path" >&2
    exit 2
fi

if [[ "$ACTION" == clean ]]; then
    rm -rf -- "$OUT"
    echo "cleaned only: $OUT"
    exit 0
fi

WARN=(
    -Wall -Wextra -Wpedantic -Werror -Wcast-align -Wcast-qual
    -Wconversion -Wdouble-promotion -Wformat=2 -Wformat-security
    -Wnested-externs -Wnull-dereference -Wold-style-definition
    -Wpointer-arith -Wredundant-decls -Wshadow -Wsign-conversion
    -Wstrict-prototypes -Wundef -Wwrite-strings -Wvla -Walloca
    -Wno-dollar-in-identifier-extension
)
CFLAGS=(
    -std=c11 -O2 -pthread "-I$SCRIPT_DIR/include" -I. "${WARN[@]}"
    -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=2 -fstack-protector-all
    -ftrivial-auto-var-init=zero -ffunction-sections -fdata-sections
)

if [[ -n "${EXTRA_CFLAGS:-}" ]]; then
    read -r -a EXTRA_C <<< "$EXTRA_CFLAGS"
    CFLAGS+=("${EXTRA_C[@]}")
fi

if [[ "$ACTION" == test ]]; then
    mkdir -p -- "$OUT"
    touch "$OUT/.gargantua-build"
    failed=0
    for t in tests/test_*.c; do
        name=$(basename "$t" .c)
        TEST_LINK=()
        case "$name" in
            test_arena)  deps=(src/core/arena.c) ;;
            test_dynbuf) deps=(src/core/dynbuf.c) ;;
            test_http)   deps=(src/http/http.c) ;;
            test_json)   deps=(src/http/json.c) ;;
            test_config) deps=(src/core/config.c) ;;
            test_response) deps=(src/http/response.c) ;;
            test_route)  deps=(src/http/route.c) ;;
            test_database)
                deps=(src/core/*.c src/db/*.c src/runtime/runtime*.c src/runtime/auth.c
                      src/http/http.c src/http/json.c src/http/response.c)
                TEST_LINK=(-lsqlite3) ;;
            *)           deps=() ;;
        esac
        if ! "$CC_BIN" "${CFLAGS[@]}" -Itests "$t" "${deps[@]}" -o "$OUT/$name" ${TEST_LINK[@]+"${TEST_LINK[@]}"}; then
            echo "  $name: BUILD FAILED" >&2
            failed=1
            continue
        fi
        if ! "$OUT/$name"; then failed=1; fi
    done

    CASE_OUT=$(mktemp -d .build-cases.XXXXXXXX)
    touch "$CASE_OUT/.gargantua-build"
    trap 'OUT="$CASE_OUT" "$0" clean >/dev/null 2>&1 || true' EXIT
    if [[ -d tests/cases ]]; then
        for case_dir in tests/cases/*/; do
            [[ -d "$case_dir" ]] || continue
            case_name=$(basename "$case_dir")
            want=$(cat "$case_dir/expect" 2>/dev/null || echo build-ok)
            OUT="$CASE_OUT" "$0" clean >/dev/null
            out=$(APP="$case_dir" OUT="$CASE_OUT" "$0" build 2>&1) && rc=0 || rc=$?
            if [[ "$want" == build-ok ]]; then
                if ((rc == 0)); then
                    printf "  %-22s ok\n" "$case_name"
                else
                    printf "  %-22s FAILED (expected a clean build)\n" "$case_name"
                    printf '%s\n' "$out" | tail -4
                    failed=1
                fi
            else
                needle=${want#error:}
                if ((rc != 0)) && printf '%s' "$out" | grep -qF "$needle"; then
                    printf "  %-22s ok (rejected)\n" "$case_name"
                else
                    printf "  %-22s FAILED (expected rejection: %s)\n" "$case_name" "$needle"
                    printf '%s\n' "$out" | tail -4
                    failed=1
                fi
            fi
        done
        OUT="$CASE_OUT" "$0" clean >/dev/null
    fi

    if ! python3 tests/package_checks.py; then failed=1; fi
    if ! python3 tests/build_checks.py; then failed=1; fi
    if ! python3 tests/integration.py; then failed=1; fi

    if ((failed != 0)); then echo "tests failed" >&2; exit 1; fi
    echo "all tests passed"
    exit 0
fi

RUNTIME=()
while IFS= read -r f; do RUNTIME+=("$f"); done \
    < <(find "$SCRIPT_DIR/src" -name '*.c' ! -path "$SCRIPT_DIR/src/generator/*" | sort)
TOOLSRC=()
while IFS= read -r f; do TOOLSRC+=("$f"); done \
    < <(find "$SCRIPT_DIR/src/generator" -name '*.c' | sort)
HEADERS=()
while IFS= read -r f; do HEADERS+=("$f"); done \
    < <(find "$SCRIPT_DIR/include" -name '*.h' | sort)
TOOL_DEPS=("${TOOLSRC[@]}" "${HEADERS[@]}")

mkdir -p -- "$OUT"
touch "$OUT/.gargantua-build"

echo "  building the generator"
"$CC_BIN" "${CFLAGS[@]}" -Wmissing-prototypes "${TOOLSRC[@]}" -o "$OUT/gargantua"

if [[ ! -d "$APP" ]]; then
    echo "no '$APP' directory. Put your .c files there." >&2
    exit 1
fi
SRC=()
while IFS= read -r -d '' source; do
    SRC+=("$source")
done < <(find "$APP" -type f -name '*.c' ! -name '*.gen.c' -print0)
if ((${#SRC[@]} == 0)); then
    echo "no .c files in '$APP'." >&2
    exit 1
fi
echo "  reading ${#SRC[@]} file(s) from $APP/"

PROPS="$APP/application.properties"
DRIVER=sqlite
if [[ -f "$PROPS" ]]; then
    VALUE=$(sed -n 's/^[[:space:]]*database\.driver[[:space:]]*=[[:space:]]*//p' "$PROPS" \
        | sed 's/[[:space:]]*#.*//; s/[[:space:]]*$//' | tail -1)
    if [[ -n "$VALUE" ]]; then DRIVER=$VALUE; fi
fi
if [[ -n "${DATABASE_DRIVER:-}" ]]; then DRIVER=$DATABASE_DRIVER; fi

if [[ "$DRIVER" != sqlite ]]; then
    echo "only SQLite is supported: remove database.driver or set it to sqlite" >&2
    exit 2
fi

prop() {
    [[ -f "$PROPS" ]] || return 0
    sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$PROPS" \
        | sed 's/[[:space:]]*#.*//; s/[[:space:]]*$//' | tail -1
}

TLS_FLAGS=()
TLS_LIBS=()
TLS_MODE=$(prop 'fetch\.tls')
if [[ -z "$TLS_MODE" ]]; then TLS_MODE=auto; fi
if [[ -f "$PROPS" ]] && grep -qE '^[[:space:]]*features[[:space:]]*=' "$PROPS"; then
    FEATURE_TEXT=" $(prop features | tr ',' ' ') "
    if [[ ! "$FEATURE_TEXT" =~ [[:space:]]fetch[[:space:]] ]]; then TLS_MODE=off; fi
fi
case "$TLS_MODE" in
    off) ;;
    auto|on)
        if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists openssl; then
            read -r -a TLS_CFLAGS <<< "$(pkg-config --cflags openssl)"
            read -r -a TLS_LDLIBS <<< "$(pkg-config --libs openssl)"
            TLS_FLAGS=(-DGARGANTUA_TLS ${TLS_CFLAGS[@]+"${TLS_CFLAGS[@]}"})
            TLS_LIBS=(${TLS_LDLIBS[@]+"${TLS_LDLIBS[@]}"})
        elif [[ "$TLS_MODE" == on ]]; then
            echo "fetch.tls=on but OpenSSL was not found via pkg-config" >&2
            exit 1
        fi
        ;;
    *)
        echo "fetch.tls accepts auto, on or off" >&2
        exit 1
        ;;
esac

DEP_LIBS=()
LIB_NAMES=()
LIB_VALUE=$(prop 'deps\.libs')
if [[ -n "$LIB_VALUE" ]]; then
    read -r -a LIB_NAMES <<< "$LIB_VALUE"
    for lib in "${LIB_NAMES[@]}"; do
        if ((${#lib} > 128)) || [[ ! "$lib" =~ ^[A-Za-z0-9][A-Za-z0-9_.+-]*$ ]]; then
            echo "unsafe deps.libs '$lib'" >&2
            exit 1
        fi
        DEP_LIBS+=("-l$lib")
    done
fi

safe_dep_path() {
    local path=$1
    if [[ -z "$path" || ${#path} -gt 512 ||
          ! "$path" =~ ^[A-Za-z0-9_./+@%:=,-]+$ ]]; then
        return 1
    fi
    case "$path" in
        .|..|./*|../*|*/./*|*/../*|*/.|*/..|*//*) return 1 ;;
    esac
    return 0
}

LIB_DIRS=()
LIBPATH_VALUE=$(prop 'deps\.libpath')
if [[ -n "$LIBPATH_VALUE" ]]; then
    read -r -a LIB_DIRS <<< "$LIBPATH_VALUE"
    for dir in "${LIB_DIRS[@]}"; do
        if ! safe_dep_path "$dir"; then
            echo "unsafe deps.libpath '$dir'" >&2
            exit 1
        fi
        DEP_LIBS+=("-L$dir")
    done
fi

INCLUDE_DIRS=()
INCLUDE_VALUE=$(prop 'deps\.include')
if [[ -n "$INCLUDE_VALUE" ]]; then
    read -r -a INCLUDE_DIRS <<< "$INCLUDE_VALUE"
    for dir in "${INCLUDE_DIRS[@]}"; do
        if ! safe_dep_path "$dir"; then
            echo "unsafe deps.include '$dir'" >&2
            exit 1
        fi
        CFLAGS+=("-I$dir")
    done
fi

PKG_NAMES=()
PKG_VALUE=$(prop 'deps\.packages')
if [[ -n "$PKG_VALUE" ]]; then
    read -r -a PKG_NAMES <<< "$PKG_VALUE"
    for package in "${PKG_NAMES[@]}"; do
        if ((${#package} > 128)) ||
           [[ ! "$package" =~ ^[A-Za-z0-9][A-Za-z0-9_.+-]*$ ]]; then
            echo "unsafe deps.packages '$package'" >&2
            exit 1
        fi
    done
    if ! command -v pkg-config > /dev/null 2>&1; then
        echo "deps.packages needs pkg-config, which was not found" >&2
        exit 1
    fi
    if ! pkg-config --exists "${PKG_NAMES[@]}"; then
        echo "missing packages: ${PKG_NAMES[*]}" >&2
        exit 1
    fi
    PKG_CFLAGS_VALUE=$(pkg-config --cflags "${PKG_NAMES[@]}")
    PKG_LIBS_VALUE=$(pkg-config --libs "${PKG_NAMES[@]}")
    PKG_CFLAGS=()
    PKG_LIBS=()
    if [[ -n "$PKG_CFLAGS_VALUE" ]]; then
        read -r -a PKG_CFLAGS <<< "$PKG_CFLAGS_VALUE"
        CFLAGS+=("${PKG_CFLAGS[@]}")
    fi
    if [[ -n "$PKG_LIBS_VALUE" ]]; then
        read -r -a PKG_LIBS <<< "$PKG_LIBS_VALUE"
        DEP_LIBS+=("${PKG_LIBS[@]}")
    fi
fi

if [[ -f "$PROPS" ]] && grep -qE '^[[:space:]]*features[[:space:]]*=' "$PROPS"; then
    FEATURES=$(prop 'features')
else
    FEATURES="fetch scheduler templates"
fi
FEATURES=${FEATURES//,/ }
for feature in $FEATURES; do
    case "$feature" in
        fetch|scheduler|templates) ;;
        *) echo "unknown feature '$feature'" >&2; exit 2 ;;
    esac
done

feature_on() {
    local want=$1 f
    for f in $FEATURES; do
        if [[ "$f" == "$want" ]]; then return 0; fi
    done
    return 1
}

drop_sources() {
    local pattern=$1 keep=() f
    for f in "${RUNTIME[@]}"; do
        if [[ "$f" != $pattern ]]; then keep+=("$f"); fi
    done
    RUNTIME=(${keep[@]+"${keep[@]}"})
}

for known in fetch scheduler templates; do
    if feature_on "$known"; then
        CFLAGS+=("-DGARGANTUA_FEATURE_$(echo "$known" | tr '[:lower:]' '[:upper:]')")
    else
        case "$known" in
            fetch)     drop_sources '*/src/runtime/fetch*.c' ;;
            scheduler) drop_sources '*/src/runtime/scheduler.c' ;;
            templates) drop_sources '*/src/http/template.c' ;;
        esac
    fi
done
echo "  features: $FEATURES"

VENDOR=()
if [[ -d vendor ]]; then
    while IFS= read -r -d '' f; do
        [[ -n "$f" ]] && VENDOR+=("$f")
    done < <(find vendor -type f -name '*.c' -print0)
fi

if ((${#VENDOR[@]} > 0)); then
    echo "  vendor: ${#VENDOR[@]} file(s)"
fi
if ((${#DEP_LIBS[@]} > 0)); then
    echo "  dependencies: ${DEP_LIBS[*]}"
fi

rm -f -- "$OUT"/app.gen.c.unit-*.c
"$OUT/gargantua" "${SRC[@]}" -o "$OUT/app.gen.c" -m
CFLAGS+=("-DCONFIG_FILE=\"$PROPS\"")

python3 "$SCRIPT_DIR/tools/package.py" prepare "$APP" "$OUT"
while IFS= read -r -d '' flag; do CFLAGS+=("$flag"); done < "$OUT/deps.cflags"
LINK=()
while IFS= read -r -d '' flag; do LINK+=("$flag"); done < "$OUT/deps.ldflags"
if [[ -n "${EXTRA_LDFLAGS:-}" ]]; then
    read -r -a EXTRA_L <<< "$EXTRA_LDFLAGS"
    LINK+=("${EXTRA_L[@]}")
fi
((${#TLS_LIBS[@]} > 0)) && LINK+=("${TLS_LIBS[@]}")
((${#DEP_LIBS[@]} > 0)) && LINK+=("${DEP_LIBS[@]}")

BUILD_SOURCES=("$OUT/app.gen.c" "${RUNTIME[@]}")
for unit in "$OUT"/app.gen.c.unit-*.c; do
    [[ -f "$unit" ]] && BUILD_SOURCES+=("$unit")
done
if ((${#VENDOR[@]} > 0)); then
    BUILD_SOURCES+=("${VENDOR[@]}")
fi

"$CC_BIN" "${CFLAGS[@]}" ${TLS_FLAGS[@]+"${TLS_FLAGS[@]}"} "${BUILD_SOURCES[@]}" \
    -o "$OUT/server" "${LINK[@]}"

if ((${#TLS_FLAGS[@]} > 0)); then
    echo "  ready: $OUT/server  (fetch: http + https)"
else
    echo "  ready: $OUT/server  (fetch: http only)"
fi

if [[ "$ACTION" == build ]]; then exit 0; fi

if [[ "$ACTION" == dev ]]; then
    DEV_PID=""
    stop_server() {
        if [[ -n "$DEV_PID" ]] && kill -0 "$DEV_PID" 2>/dev/null; then
            kill "$DEV_PID" 2>/dev/null || true
            wait "$DEV_PID" 2>/dev/null || true
        fi
        DEV_PID=""
    }
    trap 'stop_server; echo; echo "  stopped"; exit 0' INT TERM

    digest() {
        find "$APP" "$SCRIPT_DIR/src" "$SCRIPT_DIR/include" -type f \
             \( -name '*.c' -o -name '*.h' -o -name '*.properties' \) 2>/dev/null \
            | sort | while IFS= read -r file; do shasum "$file"; done 2>/dev/null | shasum | cut -d ' ' -f 1
    }

    echo "  watching $APP/ src/ include/ — ctrl-c to stop"
    "$OUT/server" &
    DEV_PID=$!
    LAST=$(digest)

    while true; do
        sleep 1
        NOW=$(digest)
        if [[ "$NOW" == "$LAST" ]]; then continue; fi
        LAST=$NOW

        echo
        echo "  change detected, rebuilding"
        stop_server
        if "$0" build; then
            "$OUT/server" &
            DEV_PID=$!
        else
            echo "  build failed — fix it and save again" >&2
        fi
    done
fi

echo
exec "$OUT/server"
